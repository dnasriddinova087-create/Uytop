# UyTop Backend Konfiguratsiyasi
PROJECT_NAME="UyTop"
VERSION="1.0.0"

# Xavfsizlik kaliti (Production muhitida murakkab kalitga almashtiring)
SECRET_KEY="uytop-super-secret-key-change-in-production-2026-secure"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080
REFRESH_TOKEN_EXPIRE_MINUTES=43200

# Ma'lumotlar bazasi
# Development uchun (avtomatik yaratiladi):
DATABASE_URL="sqlite:///./uytop.db"
# Production uchun (PostgreSQL):
# DATABASE_URL="postgresql://uytop_user:strong_password@localhost:5432/uytop_db"

# Rasm yuklash chegaralari
MAX_IMAGE_SIZE_BYTES=10485760
